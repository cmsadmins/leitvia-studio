# Paths are relative to this file.
parameters:
  level: 8
  # Lowest PHP version of Studio (Requires PHP in readme.txt).
  phpVersion: 80200
  paths:
    - leitvia-studio.php
    - uninstall.php
    - includes
    - patterns
  # WP-CLI signatures for includes/cli; the same file stands in for WP-CLI in PHPUnit.
  # WooCommerce signatures for the product comparison block.
  # Core constants the WordPress stubs leave out, such as WPINC.
  bootstrapFiles:
    - tests/php/stubs/constants.php
  scanFiles:
    - tests/php/stubs/wp-cli.php
    - tests/php/stubs/woocommerce.php
  # Own cache per checkout: parallel runs collided writing the shared system temp folder.
  tmpDir: ../../.cache/phpstan-studio
  # PHPStan reads no docblock of a method of an anonymous class, so the array shapes of these two return types stay
  # unseen; the docblocks name them. With its result cache the error does not always come up, so an unmatched entry
  # is no error.
  ignoreErrors:
    - identifier: missingType.iterableValue
      path: includes/consent/class-consent.php
      reportUnmatched: false
    - identifier: missingType.iterableValue
      path: includes/gateway/class-block-edit.php
      reportUnmatched: false
