			"expect": "<!-- wp:leitvia/map {\"zoom\":15,\"height\":\"large\",\"linkText\":\"Directions\",\"markers\":[{\"title\":\"Workshop\",\"address\":\"Main street 1\",\"lat\":48.1,\"lng\":11.5},{\"title\":\"Store\",\"lat\":48.2,\"lng\":11.6}]} -->\n<div class=\"wp-block-leitvia-map is-height-large\" id=\"find-us\"><h2 class=\"wp-block-leitvia-map__heading\">Our office</h2><ul class=\"wp-block-leitvia-map__places\"><li><strong>Workshop</strong><span>Main street 1</span><a href=\"https://www.openstreetmap.org/?mlat=48.1&amp;mlon=11.5#map=15/48.1/11.5\">Directions</a></li><li><strong>Store</strong><a href=\"https://www.openstreetmap.org/?mlat=48.2&amp;mlon=11.6#map=15/48.2/11.6\">Directions</a></li></ul></div>\n<!-- /wp:leitvia/map -->"
		},
