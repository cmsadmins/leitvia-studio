		{
			"name": "a map rebuilds its list of places from markers, zoom, height and link text; the wrapper keeps its anchor",
			"content": "<!-- wp:leitvia/map {\"markers\":[{\"title\":\"Office\",\"address\":\"Alexanderplatz 1, Berlin\",\"lat\":52.5219,\"lng\":13.4132}]} -->\n<div class=\"wp-block-leitvia-map is-height-medium\" id=\"find-us\"><h2 class=\"wp-block-leitvia-map__heading\">Our office</h2><ul class=\"wp-block-leitvia-map__places\"><li><strong>Office</strong><span>Alexanderplatz 1, Berlin</span><a href=\"https://www.openstreetmap.org/?mlat=52.5219&amp;mlon=13.4132#map=13/52.5219/13.4132\">View on OpenStreetMap</a></li></ul></div>\n<!-- /wp:leitvia/map -->",
			"block": "p:0",
			"change": {
				"attributes": {
					"zoom": 15,
					"height": "large",
					"linkText": "Directions",
					"markers": [
						{
							"title": "Workshop",
							"address": "Main street 1",
							"lat": 48.1,
							"lng": 11.5
						},
						{
							"title": "Store",
							"lat": 48.2,
							"lng": 11.6
