					"@type": "Question",
					"name": "Can we keep our existing content?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "<p>Yes. We move <strong>posts, pages and media</strong> and check the redirects.</p><ul><li>Old links keep working.</li><li>Search rankings stay.</li></ul>"
