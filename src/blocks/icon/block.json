{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "leitvia/icon",
	"version": "0.1.0",
	"title": "Icon",
	"category": "leitvia",
	"icon": "star-filled",
	"description": "An icon from the bundled set in the text color. Decorative without a label; with a label it is an image or a link.",
	"keywords": [ "symbol", "pictogram", "svg" ],
	"textdomain": "leitvia-studio",
	"attributes": {
		"icon": {
			"type": "string",
			"enum": [
				"accessibility",
				"activity",
				"arrow-right",
				"at-sign",
				"award",
				"badge-check",
				"book-open",
				"briefcase",
				"building-2",
				"cake-slice",
				"calendar",
				"camera",
				"car",
				"chart-bar",
				"check",
				"chef-hat",
				"chevron-right",
				"circle-check",
				"circle-help",
				"circle-x",
				"clipboard-check",
				"clock",
				"cloud",
				"code",
				"coffee",
				"credit-card",
				"database",
				"download",
				"drill",
				"ear",
				"euro",
				"external-link",
				"eye",
				"file-text",
				"flag",
				"gavel",
				"gift",
				"globe",
				"graduation-cap",
				"hammer",
				"hand",
				"handshake",
				"hard-hat",
				"headphones",
				"heart",
				"heart-pulse",
				"house",
				"id-card",
				"image",
				"info",
				"landmark",
				"languages",
				"leaf",
				"lightbulb",
				"link",
				"lock",
				"mail",
				"map-pin",
				"message-circle",
				"mic",
				"minus",
				"monitor",
				"moon",
				"newspaper",
				"package",
				"paintbrush",
				"party-popper",
				"percent",
				"phone",
				"pill",
				"pizza",
				"plug",
				"plus",
				"quote",
				"receipt",
				"recycle",
				"rocket",
				"ruler",
				"scale",
				"search",
				"send",
				"server",
				"settings",
				"shield-check",
				"shopping-bag",
				"shopping-cart",
				"smartphone",
				"sparkles",
				"sprout",
				"stamp",
				"star",
				"stethoscope",
				"store",
				"sun",
				"syringe",
				"tag",
				"target",
				"terminal",
				"thumbs-up",
				"triangle-alert",
				"trophy",
				"truck",
				"user",
				"users",
				"utensils",
				"video",
				"wallet",
				"wifi",
				"wine",
				"wrench",
				"x",
				"zap"
			],
			"default": "star"
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": false,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"textAlign": true
		},
		"spacing": {
			"margin": true
		}
	},
	"example": {
		"attributes": {
			"icon": "star",
			"fontSize": "heading-l"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
