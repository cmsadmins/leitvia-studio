{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "leitvia/icon",
	"version": "0.1.0",
	"title": "Icon",
	"category": "leitvia",
	"icon": "star-filled",
	"description": "An icon from the bundled set or an icon set of the site, in the text color. Decorative without a label; with a label it is an image or a link.",
	"keywords": [ "symbol", "pictogram", "svg" ],
	"textdomain": "leitvia-studio",
	"attributes": {
		"icon": {
			"type": "string",
			"default": "star"
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": false,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"textAlign": true
		},
		"spacing": {
			"margin": true
		}
	},
	"example": {
		"attributes": {
			"icon": "star",
			"fontSize": "heading-l"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
