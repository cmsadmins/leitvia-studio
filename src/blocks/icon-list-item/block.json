{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "leitvia/icon-list-item",
	"version": "0.1.0",
	"title": "Icon list item",
	"category": "leitvia",
	"icon": "yes",
	"description": "One item of an icon list: the icon of the list or its own, followed by text.",
	"keywords": [ "item", "list" ],
	"textdomain": "leitvia-studio",
	"parent": [ "leitvia/icon-list" ],
	"attributes": {
		"icon": {
			"type": "string"
		},
		"text": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": ".wp-block-leitvia-icon-list-item__text"
		}
	},
	"usesContext": [ "leitvia/iconListIcon" ],
	"supports": {
		"html": false,
		"reusable": false,
		"splitting": true
	},
	"example": {
		"attributes": {
			"text": "Free delivery from 50 euros"
		}
	}
}
