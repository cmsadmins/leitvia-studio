	"textdomain": "leitvia-studio",
	"parent": [ "leitvia/icon-list" ],
	"attributes": {
		"icon": {
			"type": "string",
			"enum": [
				"accessibility",
				"activity",
				"arrow-right",
				"at-sign",
				"award",
				"badge-check",
				"book-open",
				"briefcase",
