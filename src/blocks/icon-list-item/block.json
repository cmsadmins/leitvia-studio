				"video",
				"wallet",
				"wifi",
				"wine",
				"wrench",
				"x",
				"zap"
			]
		},
		"text": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": ".wp-block-leitvia-icon-list-item__text"
		}
	},
	"usesContext": [ "leitvia/iconListIcon" ],
	"supports": {
		"html": false,
		"reusable": false,
		"splitting": true
