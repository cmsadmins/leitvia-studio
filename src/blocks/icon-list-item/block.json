				"cake-slice",
				"calendar",
				"camera",
				"car",
				"chart-bar",
				"check",
				"chef-hat",
				"chevron-right",
				"circle-check",
				"circle-help",
				"circle-x",
				"clipboard-check",
				"clock",
				"cloud",
				"code",
				"coffee",
				"credit-card",
				"database",
				"download",
				"drill",
				"ear",
				"euro",
				"external-link",
				"eye",
				"file-text",
				"flag",
				"gavel",
				"gift",
				"globe",
				"graduation-cap",
				"hammer",
				"hand",
				"handshake",
				"hard-hat",
				"headphones",
				"heart",
				"heart-pulse",
				"house",
				"id-card",
				"image",
