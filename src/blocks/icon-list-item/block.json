				"landmark",
				"languages",
				"leaf",
				"lightbulb",
				"link",
				"lock",
				"mail",
				"map-pin",
				"message-circle",
				"mic",
				"minus",
				"monitor",
				"moon",
				"newspaper",
				"package",
				"paintbrush",
				"party-popper",
				"percent",
				"phone",
				"pill",
				"pizza",
				"plug",
				"plus",
				"quote",
				"receipt",
				"recycle",
				"rocket",
				"ruler",
				"scale",
				"search",
				"send",
				"server",
				"settings",
				"shield-check",
