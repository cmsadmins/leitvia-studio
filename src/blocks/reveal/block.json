{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "leitvia/reveal",
	"version": "0.1.0",
	"title": "Reveal",
	"category": "leitvia",
	"icon": "visibility",
	"description": "Shows or lifts its content in while it scrolls into view; text is never shown half faded. Without support for scroll-driven animation or with reduced motion the content simply shows.",
	"keywords": [ "animation", "scroll", "fade" ],
	"textdomain": "leitvia-studio",
	"attributes": {
		"effect": {
			"type": "string",
			"enum": [ "fade", "rise", "stagger" ],
			"default": "rise"
		}
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"layout": {
			"default": {
				"type": "constrained"
			}
		}
	},
	"example": {
		"innerBlocks": [ { "name": "core/paragraph", "attributes": { "content": "This text appears while it scrolls into view." } } ]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
