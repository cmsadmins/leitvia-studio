{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "leitvia/language-switch",
	"version": "0.1.0",
	"title": "Easy language switch",
	"category": "leitvia",
	"icon": "book",
	"description": "Links a page to its version in easy language and back. Shows nothing while the page has no published counterpart.",
	"keywords": [ "easy language", "plain language", "accessibility", "BITV" ],
	"textdomain": "leitvia-studio",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true
		}
	},
	"example": {},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
