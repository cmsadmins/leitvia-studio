{
	"example": "<!-- wp:leitvia/pricing -->\n<div class=\"wp-block-leitvia-pricing\"><fieldset class=\"wp-block-leitvia-pricing__period\"><legend>Billing period</legend><label><input type=\"radio\" name=\"leitvia-pricing-\" value=\"monthly\" checked/><span class=\"wp-block-leitvia-pricing__monthly\">Monthly</span></label><label><input type=\"radio\" name=\"leitvia-pricing-\" value=\"yearly\"/><span class=\"wp-block-leitvia-pricing__yearly\">Yearly</span></label></fieldset><div class=\"wp-block-leitvia-pricing__plans\"><!-- wp:leitvia/pricing-plan {\"monthly\":9,\"yearly\":90} -->\n<article class=\"wp-block-leitvia-pricing-plan\"><h3 class=\"wp-block-leitvia-pricing-plan__name\">Basic</h3><p class=\"wp-block-leitvia-pricing-plan__price wp-block-leitvia-pricing-plan__price--monthly\"></p><p class=\"wp-block-leitvia-pricing-plan__price wp-block-leitvia-pricing-plan__price--yearly\"></p><div class=\"wp-block-leitvia-pricing-plan__content\"></div></article>\n<!-- /wp:leitvia/pricing-plan -->\n\n<!-- wp:leitvia/pricing-plan {\"monthly\":19,\"yearly\":190,\"recommended\":true} -->\n<article class=\"wp-block-leitvia-pricing-plan is-recommended\"><h3 class=\"wp-block-leitvia-pricing-plan__name\">Pro</h3><p class=\"wp-block-leitvia-pricing-plan__badge\">Recommended</p><p class=\"wp-block-leitvia-pricing-plan__price wp-block-leitvia-pricing-plan__price--monthly\"></p><p class=\"wp-block-leitvia-pricing-plan__price wp-block-leitvia-pricing-plan__price--yearly\"></p><div class=\"wp-block-leitvia-pricing-plan__content\"></div></article>\n<!-- /wp:leitvia/pricing-plan --></div></div>\n<!-- /wp:leitvia/pricing -->",
	"usage": {
		"useWhen": "Two to four plans with monthly and yearly prices on a pricing page.",
		"avoidWhen": "A single price or prices without periods; use a group with text.",
		"a11y": "The period switch is a native radio group with a legend and works without JavaScript; prices are text, not images."
	}
