{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "leitvia/form-errors",
	"version": "0.1.0",
	"title": "Form error summary",
	"category": "leitvia",
	"icon": "warning",
	"description": "Wraps any form and lists its errors above it with links to the fields. Without JavaScript the browser and the form plugin validate as before.",
	"keywords": [ "form", "validation", "accessibility", "errors" ],
	"textdomain": "leitvia-studio",
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"layout": {
			"default": {
				"type": "constrained"
			}
		}
	},
	"example": {
		"innerBlocks": [ { "name": "core/paragraph", "attributes": { "content": "Place a form here." } } ]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}
